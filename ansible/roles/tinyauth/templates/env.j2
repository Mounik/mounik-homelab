# TinyAuth - Variables d'environnement
# Généré par Ansible - NE PAS MODIFIER MANUELLEMENT

USERS={{ tinyauth_users }}
SECRET={{ tinyauth_secret }}
{% if tinyauth_oauth_github_enabled %}
PROVIDERS_GITHUB_CLIENT_ID={{ tinyauth_oauth_github_client_id }}
PROVIDERS_GITHUB_CLIENT_SECRET={{ tinyauth_oauth_github_client_secret }}
OAUTH_WHITELIST={{ tinyauth_oauth_whitelist }}
{% endif %}
