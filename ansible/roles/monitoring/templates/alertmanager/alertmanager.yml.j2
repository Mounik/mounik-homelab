global:
  resolve_timeout: 5m
{% if alertmanager_smtp_host %}
  smtp_smarthost: "{{ alertmanager_smtp_host }}"
  smtp_from: "{{ alertmanager_smtp_from }}"
  smtp_require_tls: true
{% endif %}

route:
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'default'

  routes:
    - match:
        severity: critical
      receiver: 'critical'
      repeat_interval: 1h

receivers:
  - name: 'default'
{% if alertmanager_smtp_host %}
    email_configs:
      - to: '{{ alertmanager_receiver_email }}'
        send_resolved: true
{% endif %}

  - name: 'critical'
{% if alertmanager_smtp_host %}
    email_configs:
      - to: '{{ alertmanager_receiver_email }}'
        send_resolved: true
{% endif %}

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']
