global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "alert-rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  # ── Prometheus lui-même ─────────────────────────────────────
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # ── Node Exporter (métriques système de la VM monitoring) ──
  - job_name: "node-exporter"
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          instance: "monitoring"

  # ── cAdvisor (métriques containers Docker) ─────────────────
  - job_name: "cadvisor"
    static_configs:
      - targets: ["cadvisor:8080"]

  # ── Traefik (reverse proxy) ────────────────────────────────
  - job_name: "traefik"
    static_configs:
      - targets: ["192.168.20.100:8080"]
        labels:
          instance: "traefik"

  # ── k3s cluster ────────────────────────────────────────────
  - job_name: "k3s-node01"
    static_configs:
      - targets: ["192.168.20.200:9100"]
        labels:
          instance: "k3s-node01"

  - job_name: "k3s-node02"
    static_configs:
      - targets: ["192.168.20.210:9100"]
        labels:
          instance: "k3s-node02"

  # ── Proxmox (via exporter) ─────────────────────────────────
  - job_name: "proxmox"
    static_configs:
      - targets:
          - "192.168.1.20:9221"
          - "192.168.1.21:9221"
          - "192.168.1.22:9221"
