groups:
  # ── Règles système ──────────────────────────────────────────
  - name: system
    rules:
      - alert: HighCPUUsage
        expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "CPU élevé sur {{ $labels.instance }}"
          description: "CPU utilisé à {{ $value | printf \"%.1f\" }}% depuis 5 minutes"

      - alert: HighMemoryUsage
        expr: (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "RAM élevée sur {{ $labels.instance }}"
          description: "RAM utilisée à {{ $value | printf \"%.1f\" }}%"

      - alert: DiskSpaceLow
        expr: (1 - node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) * 100 > 85
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Espace disque faible sur {{ $labels.instance }}"
          description: "Disque utilisé à {{ $value | printf \"%.1f\" }}%"

      - alert: NodeDown
        expr: up{job="node-exporter"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Nœud {{ $labels.instance }} down"
          description: "Le nœud ne répond plus depuis 2 minutes"

  # ── Règles containers ───────────────────────────────────────
  - name: containers
    rules:
      - alert: ContainerDown
        expr: absent(container_last_seen{name=~".+"})
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "Container arrêté"
          description: "Un container a cessé de fonctionner"

      - alert: ContainerHighCPU
        expr: rate(container_cpu_usage_seconds_total{name=~".+"}[5m]) * 100 > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Container {{ $labels.name }} CPU élevé"
          description: "CPU utilisé à {{ $value | printf \"%.1f\" }}%"

      - alert: ContainerHighMemory
        expr: container_memory_usage_bytes{name=~".+"} / container_spec_memory_limit_bytes * 100 > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Container {{ $labels.name }} RAM élevée"
          description: "RAM utilisée à {{ $value | printf \"%.1f\" }}%"

  # ── Règles services ─────────────────────────────────────────
  - name: services
    rules:
      - alert: ServiceDown
        expr: up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Service {{ $labels.job }} down"
          description: "Le service ne répond plus depuis 2 minutes"

      - alert: TraefikHighRequestRate
        expr: rate(traefik_http_requests_total[5m]) > 100
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Traefik: taux de requêtes élevé"
          description: "{{ $value | printf \"%.0f\" }} requêtes/seconde"

  # ── Règles Kubernetes ───────────────────────────────────────
  - name: kubernetes
    rules:
      - alert: K8sNodeNotReady
        expr: kube_node_status_condition{condition="Ready",status="true"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Nœud K8s {{ $labels.node }} not ready"
          description: "Le nœud Kubernetes n'est pas prêt"

      - alert: K8sPodCrashLooping
        expr: rate(kube_pod_container_status_restarts_total[15m]) * 60 * 5 > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Pod {{ $labels.pod }} crash-looping"
          description: "Le pod redémarre en boucle"

      - alert: K8sPodNotReady
        expr: kube_pod_status_phase{phase=~"Pending|Unknown"} > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Pod {{ $labels.pod }} pas prêt"
          description: "Le pod est en état Pending ou Unknown depuis 10 minutes"
